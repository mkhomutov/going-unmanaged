{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build: Debug, sanitizers on, compile database",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYPLUGIN_SANITIZE": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release build, the configuration you ship",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } }
  ]
}
